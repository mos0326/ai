# ============================================================
#  Personal AI — 環境変数サンプル
#  backend/ で `cp ../.env.example .env` して値を埋めてください。
#  すべて未設定でもサーバーは起動します（該当機能だけ無効化/フォールバック）。
# ============================================================

# --- アプリ / ユーザー ---
APP_NAME=Personal AI
# AIがあなたを呼ぶ名前（システムプロンプトに注入されます）
OWNER_NAME=あなた
# フロントの開発サーバーなど、CORSで許可するオリジン（カンマ区切り）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- データベース ---
# 既定は同ディレクトリの SQLite。Postgres例: postgresql+psycopg://user:pass@localhost:5432/personal_ai
DATABASE_URL=sqlite:///./personal_ai.db

# --- Anthropic (Claude) ---
# 未設定だとチャット/リサーチ/記憶抽出が使えません（明示的なエラーを返します）
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-4-6
EXTRACTION_MODEL=claude-haiku-4-5-20251001
RESEARCH_MODEL=claude-sonnet-4-6
MAX_TOKENS=2048

# --- 埋め込み（記憶のベクトル検索） ---
# auto: OPENAI_API_KEY があれば openai、無ければ local フォールバック
# 選択肢: auto | openai | voyage | local
EMBEDDING_PROVIDER=auto
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3
# local フォールバック時の次元数
LOCAL_EMBEDDING_DIM=384

# --- 検索 / リサーチ ---
# 選択肢: tavily | brave | none
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
RESEARCH_MAX_RESULTS=6
RESEARCH_FETCH_PAGES=4

# --- 文字起こし ---
# 選択肢: openai (Whisper API) | faster-whisper (ローカル, 要 `pip install faster-whisper` と ffmpeg)
TRANSCRIPTION_PROVIDER=openai
WHISPER_MODEL=whisper-1
FASTER_WHISPER_MODEL=base

# --- 記憶システムのチューニング ---
MEMORY_TOP_K=6
MEMORY_MIN_SIMILARITY=0.25
MEMORY_EXTRACTION_ENABLED=true
